<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — Dark theme overrides.
    Copy to: app/src/main/res/values-night/themes.xml
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SMGRApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Accent (primary) — kept original green -->
        <item name="colorPrimary">@color/main_color_dark</item>
        <item name="colorPrimaryVariant">@color/main_color_dark</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/main_color_dark</item>
        <item name="colorSecondaryVariant">@color/bg_raised</item>
        <!--
            FIX: colorOnSecondary was green → now neutral text.
            This was the main cause of the "everything is green" problem.
        -->
        <item name="colorOnSecondary">@color/text_primary_dark</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/bg_raised</item>
        <item name="colorOnSurfaceVariant">@color/bg_stroke</item>

        <!-- Custom attrs -->
        <item name="colorTab">@color/main_color_dark</item>

        <!--
            KEY FIX: colorText used to be accent green (#09BF9B).
            Now it is light neutral text (#D8DCE0).
            Values and dynamic data will be readable white, not green.
            Green is now reserved for accent/interactive elements only.
        -->
        <item name="colorText">@color/text_primary_dark</item>

        <!--
            colorStaticText: labels/hints — muted gray, same intent as before
            but higher contrast than the old semi-transparent green.
        -->
        <item name="colorStaticText">@color/text_secondary_dark</item>

        <!-- Card/row alternating background -->
        <item name="colorOrvTxtBackground">@color/orv_background_color_dark</item>

        <!-- App background -->
        <item name="colorMainBackground">@color/bg_primary</item>

        <!-- Misc -->
        <item name="colorPlayBtn">@color/play_btn_color_dark</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_primary</item>
    </style>
</resources>
