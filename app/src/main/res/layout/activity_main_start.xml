<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — activity_main_start.xml
    Compact-версия стартового экрана до тапа.
    Содержит ТОЛЬКО видимые элементы:
      • Заголовок "Сводный справочник / грузовых вагонов" (2 строки, акцент на "вагонов")
      • Поезд + дым (Lottie)
      • Подсказка "Нажми на поезд!"
    Остальные элементы (description, dates, кнопки) присутствуют, но
    alpha=0 + invisible — проявятся при expandLayout().

    Типографика приведена к общей дизайн-системе:
      Lato Bold для hero-title, Lato Caption для описаний, IBM Plex Mono
      для технических данных (дат).

    Дым привязан к Guideline на 18% ширины экрана — ровно по трубе поезда.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorMainBackground"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.MainActivity"
    android:fitsSystemWindows="true">    <!-- ← добавить -->>

    <!-- ── Заголовок: "Сводный справочник" ────────────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        style="@style/SMGR.Main.HeroTitle"
        android:text="Сводный справочник"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Заголовок: "грузовых вагонов" (акцент) ─────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titleAccent"
        style="@style/SMGR.Main.HeroTitle"
        android:text="грузовых вагонов"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- ── Описание (скрыто до раскрытия) ─────────────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/data"
        style="@style/SMGR.Main.Caption"
        android:text="Включает данные справочников"
        android:paddingTop="20dp"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleAccent" />

    <!-- ── Даты СМГР (скрыты до раскрытия) ────────────────────── -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerSmgrDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/data">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/smgr1Txt"
            style="@style/SMGR.Main.TechLine"
            android:text="@string/txtView_smgr1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/smgr2Txt"
            style="@style/SMGR.Main.TechLine"
            android:text="@string/txtView_smgr2" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ── Guideline для дыма (18% от левого края экрана) ─────── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/smokeGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <!-- ── Дым (Lottie) ───────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/layout_smoke"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="-15dp"
        app:layout_constraintBottom_toTopOf="@id/titleImage"
        app:layout_constraintStart_toStartOf="@id/smokeGuideline"
        app:layout_constraintEnd_toEndOf="@id/smokeGuideline">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/smoke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/smoke" />
    </FrameLayout>

    <!-- ── Поезд (центральное изображение) ────────────────────── -->

    <!-- ── Подсказка "Нажми на поезд!" ────────────────────────── -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/titleImage"
        android:layout_width="@dimen/main_activity_image_width"
        android:layout_height="@dimen/main_activity_image_height"
        android:background="?attr/colorMainBackground"
        android:scaleType="fitCenter"
        android:src="@drawable/title_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleAccent"
         />

    <TextView
        android:id="@+id/clickToStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/activity_main_push_train"
        android:textColor="?attr/colorStaticText"
        android:textSize="13sp"
        android:fontFamily="@font/lato"
        android:letterSpacing="0.05"
        android:layout_marginBottom="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── Кнопки (скрыты до раскрытия) ───────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToSmgr"
        style="@style/Widget.Material3.Button.Main_Activity_Btn"
        android:layout_width="@dimen/main_activity_btn_width"
        android:layout_height="50dp"
        android:text="@string/btn_enter_smgr"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToOrv"
        style="@style/Widget.Material3.Button.Main_Activity_Btn"
        android:layout_width="@dimen/main_activity_btn_width"
        android:layout_height="50dp"
        android:text="@string/btn_enter_orv"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── Контейнер для AdMob-баннера (скрыт до раскрытия) ─── -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>