<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorMainBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Series prefix badge — 32dp -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/seriesCard"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorSurfaceVariant"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/seriesBadgeText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:includeFontPadding="false" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Body: model code + subtitle -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/itemBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/capacityBadgeLayout"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@id/seriesCard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/modelTextView"
            style="@style/SMGR.ListItem.ModelCode" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/subtitleTextView"
            style="@style/SMGR.ListItem.Subtitle" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Capacity badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/capacityBadgeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/accent_badge_bg"
        app:cardCornerRadius="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/accent_badge_stroke"
        app:cardElevation="0dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@id/arrowText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/capacityTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/arrowText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="?attr/colorStaticText"
        android:textSize="18sp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!--
        CHANGED — divider на границе между item'ами.
        layout_marginBottom="-8dp" компенсирует paddingBottom=8dp родителя,
        выталкивая разделитель за зону padding'а. Итог: 8dp воздуха сверху
        от divider'а и 8dp снизу (paddingTop следующего item'а) = симметрия.
    -->
    <View
        android:id="@+id/itemDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant"
        android:alpha="0.4"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden bindings (обратная совместимость) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/yearOfReleaseTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/yearEndOfReleaseTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>