<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — fragment_parameter_wagon.xml
    Copy to: app/src/main/res/layout/fragment_parameter_wagon.xml

    Changes vs original:
    - Hero header: image + model code + capacity number
    - Parameters grouped into MaterialCardView sections
    - Section headers (SMGR.SectionHeader style)
    - Values right-aligned with fixed unit column
    - All view IDs preserved — no Kotlin changes needed
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorMainBackground"
    tools:context=".ui.smgr.ParameterWagonFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HERO HEADER ── -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="?attr/colorSurface"
                android:gravity="center_vertical">

                <HorizontalScrollView
                    android:id="@+id/imageScrollView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/wagonPhotoUrl"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="fitCenter"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null" />

                </HorizontalScrollView>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?attr/colorSurfaceVariant" />

            <!-- Model + type info + capacity -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="12dp"
                android:layout_gravity="center">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/wagonModel"
                    style="@style/SMGR.HeroModelCode"
                    android:layout_marginEnd="5dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/wagonCapacity"
                    style="@style/SMGR.HeroCapacity"
                    android:layout_marginEnd="5dp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SMGR.HeroCapacityLabel"
                    android:layout_gravity="bottom"
                    android:text="тонн" />

            </androidx.appcompat.widget.LinearLayoutCompat>
            <!-- ══════════════════════════════════════════
                 SECTION 1 — ИДЕНТИФИКАЦИЯ
            ══════════════════════════════════════════ -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/SMGR.SectionHeader"
                android:text="Идентификация" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Особенность -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow"
                        android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_property" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonProperty"
                            style="@style/SMGR.ParamValue"
                            android:maxWidth="180dp"
                            android:gravity="end"
                            android:hint="@string/txtView_property" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Специализация -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_specialization" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonSpecialization"
                            style="@style/SMGR.ParamValue" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Материал кузова -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow"
                        android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_material" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonMaterial"
                            style="@style/SMGR.ParamValue" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Изготовитель -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_factory" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonFactory"
                            style="@style/SMGR.ParamValue"
                            android:maxWidth="160dp"
                            android:gravity="end" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Год выпуска -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow"
                        android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_year_release" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonYearOfRelease"
                            style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamUnit"
                            android:text="–" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonYearEndOfRelease"
                            style="@style/SMGR.ParamValue" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Срок службы -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamLabel"
                            android:text="@string/txtView_service_life" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wagonServiceLife"
                            style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SMGR.ParamUnit"
                            android:text="лет" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 SECTION 2 — МАССОВО-ВЕСОВЫЕ
            ══════════════════════════════════════════ -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/SMGR.SectionHeader"
                android:text="Массово-весовые" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Тара min -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow" android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_tare_min" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonTareMin" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_tare_min_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Тара max -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_tare_max" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonTareMax" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_tare_max_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Тара min (эксп.) -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow" android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_tare_min_exp" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonTareMinExp" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_tare_min_exp_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Осевая нагрузка -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_axial_load" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonAxialLoad" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_axial_load_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 SECTION 3 — ГЕОМЕТРИЯ
            ══════════════════════════════════════════ -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/SMGR.SectionHeader"
                android:text="Геометрия" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Длина -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow" android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_length" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonLength" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_length_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Длина по а/с -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_long" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonLong" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="мм" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Осность -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow" android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_num_axles" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonNumAxles" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text=" " />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Объём -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_volume" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonVolume" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text="@string/txtView_volume_unit" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 SECTION 4 — ХОДОВАЯ ЧАСТЬ
            ══════════════════════════════════════════ -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/SMGR.SectionHeader"
                android:text="Ходовая часть" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Тележка -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow" android:background="?attr/colorMainBackground">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_bogie" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonBogie" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text=" " />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginStart="14dp" />

                    <!-- Габарит -->
                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.CardRow">
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamLabel" android:text="@string/txtView_size" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/wagonSize" style="@style/SMGR.ParamValue" />
                        <com.google.android.material.textview.MaterialTextView style="@style/SMGR.ParamUnit" android:text=" " />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
