<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — item_cargos.xml
    Было: MaterialCardView с margin 6dp + border → визуально "таблетки".
    Стало: обычная строка списка с:
      • бейджем кода ЕТСНГ слева (как seriesBadge в списке моделей),
      • названием груза справа (основной текст),
      • тонким divider'ом между строками (как в WagonsActivity).
    Единая эстетика со списком моделей и деталями вагона.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/colorMainBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Бейдж кода ЕТСНГ — визуальный эквивалент seriesBadge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/codeBadgeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        app:cardBackgroundColor="@color/accent_badge_bg"
        app:cardCornerRadius="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/accent_badge_stroke"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/codeEtsngTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:layout_gravity="center"
            tools:text="211030" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Название груза — читаемый Lato, многострочный по необходимости -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nameEtsngTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:fontFamily="@font/lato"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/codeBadgeCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/codeBadgeCard"
        app:layout_constraintBottom_toBottomOf="@id/codeBadgeCard"
        app:layout_constraintVertical_bias="0"
        tools:text="Бензин для промышленных целей" />

    <!-- Divider на границе между строками -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant"
        android:alpha="0.4"
        android:layout_marginStart="68dp"
        android:layout_marginBottom="-10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>