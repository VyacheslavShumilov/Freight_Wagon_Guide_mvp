<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — activity_main_end.xml
    Финальный макет после анимации раскрытия.
    Структура идентична activity_main_start.xml по id и элементам
    (требование ConstraintSet.clone) — различается только позициями
    и alpha/visibility.

    Иерархия кнопок:
      • btnToSmgr + btnToOrv — равнозначные primary (одинаковый стиль).
      • btnCheckUpdate — outlined, вспомогательная (сервисное действие).

    Типографика единая со start-версией: SMGR.Main.HeroTitle / Caption /
    TechLine — связывает стартовый экран со всем остальным приложением.

    Поезд с marginTop="40dp" от containerSmgrDate — даёт запас 55dp
    над верхней кромкой поезда, куда помещается контейнер дыма (80dp
    с marginBottom=-15dp) не перекрывая блок дат.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorMainBackground"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.MainActivity"
    android:fitsSystemWindows="true">    <!-- ← добавить -->>

    <!-- ── Заголовок: "Сводный справочник" ────────────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        style="@style/SMGR.Main.HeroTitle"
        android:text="Сводный справочник"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Заголовок: "грузовых вагонов" (акцент) ─────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titleAccent"
        style="@style/SMGR.Main.HeroTitle"
        android:text="грузовых вагонов"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- ── Описание ──────────────────────────────────────────── -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/data"
        style="@style/SMGR.Main.Caption"
        android:text="Включает данные справочников"
        android:paddingTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleAccent" />

    <!-- ── Даты СМГР ─────────────────────────────────────────── -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerSmgrDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/data">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/smgr1Txt"
            style="@style/SMGR.Main.TechLine"
            android:text="@string/txtView_smgr1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/smgr2Txt"
            style="@style/SMGR.Main.TechLine"
            android:text="@string/txtView_smgr2" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ── Guideline для дыма (та же позиция, что в start) ────── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/smokeGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <!-- ── Дым ───────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/layout_smoke"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="-15dp"
        app:layout_constraintBottom_toTopOf="@id/titleImage"
        app:layout_constraintStart_toStartOf="@id/smokeGuideline"
        app:layout_constraintEnd_toEndOf="@id/smokeGuideline">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/smoke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/smoke" />
    </FrameLayout>

    <!-- ── Поезд ─────────────────────────────────────────────── -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/titleImage"
        android:layout_width="@dimen/main_activity_image_width"
        android:layout_height="@dimen/main_activity_image_height"
        android:background="?attr/colorMainBackground"
        android:scaleType="fitCenter"
        android:src="@drawable/title_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleAccent" />

    <!-- ── Подсказка (скрыта после раскрытия) ────────────────── -->
    <TextView
        android:id="@+id/clickToStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/activity_main_push_train"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/titleImage" />

    <!-- ── Карточка «3D-модели вагонов» ────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card3dWagons"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="@dimen/main_activity_btn_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorSurfaceVariant"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleImage">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_cube_3d"
                app:tint="?attr/colorPrimary" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SMGR.Orv.Tile.Title"
                    android:paddingTop="0dp"
                    android:text="@string/wagons3d_card_title" />

                <!-- colorOnSurface + alpha: colorStaticText в тёмной теме
                     (#6B7580 на #141618) не дотягивает до AA для 12sp -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.72"
                    android:fontFamily="@font/lato"
                    android:includeFontPadding="false"
                    android:text="@string/wagons3d_card_subtitle"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Кнопка СМГР (primary) ─────────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToSmgr"
        style="@style/Widget.Material3.Button.Main_Activity_Btn"
        android:layout_width="@dimen/main_activity_btn_width"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="@string/btn_enter_smgr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card3dWagons" />

    <!-- ── Кнопка ОРВ (primary, равнозначная) ────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToOrv"
        style="@style/Widget.Material3.Button.Main_Activity_Btn"
        android:layout_width="@dimen/main_activity_btn_width"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_enter_orv"
        app:layout_constraintBottom_toTopOf="@id/adContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnToSmgr" />

    <!-- ── Контейнер для AdMob-баннера ───────────────────────── -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>