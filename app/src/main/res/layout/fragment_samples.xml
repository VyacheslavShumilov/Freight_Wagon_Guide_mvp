<?xml version="1.0" encoding="utf-8"?><!--
    REDESIGN — fragment_samples.xml

    Изменения:
    1. Корень был ConstraintLayout с попарными привязками карточек
       cardView2.constraintTop_toBottomOf=cardView1. Перешли на GridLayout
       с 2 колонками — карточки сами выстраиваются, привязки не нужны.
    2. Решена проблема "плохой скролл": ScrollView + GridLayout не имеют
       прослойки constraints, которые перехватывали жесты — теперь
       прокрутка работает на любом месте экрана.
    3. Стиль карточек переведён на SMGR.Orv.Tile (тот же, что в
       fragment_orv_list и fragment_bogie_components):
         • тонкая граница colorSurfaceVariant 1dp
         • радиус 14dp
         • elevation 0dp
         • воздух 6dp между карточками
       Это даёт визуальную связь со всеми остальными ОРВ-экранами.
    4. Текст карточек переведён на SMGR.Orv.Tile.Title (Lato bold) —
       сейчас был старый Bogies_Components_Item_Header.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorMainBackground"
    tools:context=".ui.orv.SamplesFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/constrainSamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp"
            app:columnCount="2">

            <!-- 1. Абсолютный шаблон -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewAbs"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageAbs"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_abs" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_1" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. ВПГ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewVpg"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageVpg"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_vpg" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_2" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Толщина гребня -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewThick"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageThick"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_thick" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_3" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Комбинированный -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewComb"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageComb"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_comb" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_4" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Скоба -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewBrace"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageBrace"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_brace" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_5" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Профиль -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewProf"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageProf"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_prof" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_6" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. T873 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView873"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/image873"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_873" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_7" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. Высота гребня -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewHeight"
                style="@style/SMGR.Orv.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SMGR.Orv.Tile.Content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sample_height" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_samples_8" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

        </androidx.gridlayout.widget.GridLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>