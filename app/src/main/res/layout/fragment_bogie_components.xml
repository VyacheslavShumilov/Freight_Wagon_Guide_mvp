<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — fragment_bogie_components.xml

    Изменения:
    1. ProgressBar и layoutNotConnection помещены внутрь FrameLayout
       вместе с RecyclerView. Они лежат слоями: лоадер поверх списка,
       блок "нет интернета" поверх лоадера. layout_gravity=center
       центрирует лоадер на экране, а не клеит его под списком.
    2. Удалены неработающие app:layout_constraint* — они применимы только
       внутри ConstraintLayout, а корень здесь LinearLayoutCompat,
       и константы просто игнорировались.
    3. RecyclerView получил layout_height=match_parent — занимает всё
       свободное место под заголовком, чтобы скролл работал корректно
       (раньше при wrap_content список мог обрезаться/скроллится с
       внешним ScrollView).
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorMainBackground"
    android:orientation="vertical"
    tools:context=".ui.orv.bogies.BogiesListFragment"
    android:fitsSystemWindows="true">    <!-- ← добавить -->>

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/modelWagon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Bogies_Components_Item_Header_Medium"
            android:textAlignment="center"
            android:paddingTop="@dimen/frag_bogie_comp_txtView_paddingTop"
            android:paddingBottom="@dimen/frag_bogie_comp_txtView_paddingBottom"
            android:text="@string/frag_bogie_components_txtView_document" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="?attr/colorSurfaceVariant" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--
        Контейнер контента и состояний.
        FrameLayout укладывает дочерние элементы слоями;
        видимость переключается из Kotlin (view.visibility = ...).
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

        <!-- ProgressBar центрируется по экрану через layout_gravity -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Блок "нет интернета" — тоже по центру -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutNotConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/No_Internet_Text"
                android:layout_marginBottom="@dimen/txtView_no_internet_margin_bottom"
                android:gravity="center"
                android:text="@string/no_internet_txtView" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClickReply"
                style="@style/Widget.Material3.Button.Main_Activity_Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeated_request_bnt" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>