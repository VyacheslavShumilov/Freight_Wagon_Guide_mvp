<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — fragment_bogie_components.xml
    Изменения:
      • Хедер "frag_bogie_components_txtView_document" переведён на стиль
        SMGR.SectionHeader (та же эстетика, что разделы на экране вагона).
      • RecyclerView получил паддинги 4dp по краям — чтобы карточки
        с margin=6dp встали в аккуратную сетку 2×N.
      • Экран теперь использует фон colorMainBackground — раньше брался
        системный.
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorMainBackground"
    android:orientation="vertical"
    tools:context=".ui.orv.bogies.BogiesListFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/modelWagon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            style="@style/SMGR.SectionHeader"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:text="@string/frag_bogie_components_txtView_document" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="?attr/colorSurfaceVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutNotConnection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/No_Internet_Text"
                android:layout_marginBottom="@dimen/txtView_no_internet_margin_bottom"
                android:gravity="center"
                android:text="@string/no_internet_txtView" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClickReply"
                style="@style/Widget.Material3.Button.Main_Activity_Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeated_request_bnt" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>