<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — item_bogies.xml
    Карточка тележки в сетке 2 колонки.
    Унифицирована с карточками моделей/параметров вагонов:
      • фон colorSurface, тонкая рамка colorSurfaceVariant 1dp
      • радиус 12dp, elevation 0dp
      • код модели моноширинным IBM Plex Mono bold (как код вагона)
      • производитель — Lato normal приглушённый серый
    Фиксированная высота убрана — карточка растягивается под
    многострочное имя производителя без обрезания.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="84dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorSurfaceVariant"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/modelBogieTextView"
            style="@style/SMGR.Bogie.Code"
            android:hint="@string/item_bogies_hint_txtView_bogie" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/bogieFactoryTextView"
            style="@style/SMGR.Bogie.Factory"
            android:hint="@string/item_bogie_comp_txtView_bogieFactory" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>