<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — activity_wagon.xml
    Copy to: app/src/main/res/layout/activity_wagon.xml

    Changes vs original:
    - Removed DotsIndicator (viewpagerdotsindicator library)
    - Removed TabLayout
    - Added BottomNavigationView with labeled tabs
    - ViewPager2 fills remaining space
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorMainBackground"
    tools:context=".ui.smgr.WagonActivity"
    android:fitsSystemWindows="true">    <!-- ← добавить -->>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Кнопка «Посмотреть в 3D» — видна, если для рода вагона есть раздел
         на сайте (Wagons3dLauncher.anchorFor) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnView3d"
        style="@style/SMGR.Button.View3d"
        android:text="@string/wagons3d_btn_view"
        android:visibility="gone" />

    <!-- Баннер AdMob (BannerAdHelper): GONE до onAdLoaded -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Divider above bottom nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/SMGR.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/wagon_bottom_nav" />

</androidx.appcompat.widget.LinearLayoutCompat>
