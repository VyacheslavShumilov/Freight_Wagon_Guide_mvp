<?xml version="1.0" encoding="utf-8"?>
<!--
    REDESIGN — fragment_orv_list.xml
    Было: MaterialCardView-тайлы через CustomCardView-стиль с серыми границами
    и большими отступами — визуально «тяжёлая» плитка 90-х.
    Стало: та же сетка 2x3, но тайлы в единой стилистике с карточками
    моделей/параметров — тонкая граница colorSurfaceVariant, фон colorSurface,
    акцент на иконке, заголовок моноширинным IBM Plex Mono bold.
-->
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorMainBackground"
    tools:context=".ui.orv.OrvActivity"
    android:fitsSystemWindows="true">    <!-- ← добавить -->>

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            app:columnCount="2"
            app:rowCount="3">

            <!-- 1. Автосцепка -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewAutomaticCoupler"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="0"
                app:layout_column="0"

                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/automatic_coupler"
                         />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_automatic_coupler" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Тормозная система -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewBreakSystem"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="0"
                app:layout_column="1"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/brake_system"
                         />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_brake_system" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Колёсная пара -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewWheelset"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="1"
                app:layout_column="0"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/wheelset"
                         />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_wheelset" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Тележка -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewBogie"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="1"
                app:layout_column="1"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/bogie"
                         />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/rag_orv_list_txtView_bogie" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Детали тележки -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewComponents"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="2"
                app:layout_column="0"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/components"
                         />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_components" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Шаблоны -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewSamples"
                style="@style/SMGR.Orv.Tile"
                app:layout_row="2"
                app:layout_column="1"
                app:layout_columnWeight="1">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SMGR.Orv.Tile.Content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/cardView_imageView_width"
                        android:layout_height="@dimen/cardView_imageView_height"
                        android:src="@drawable/sample"
                        />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SMGR.Orv.Tile.Title"
                        android:text="@string/txtView_sample" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>