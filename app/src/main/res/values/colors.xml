    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00FFFFFF</color>

    <!-- Redesign: accent (kept from original) -->
    <color name="main_color_light">#8009B36F</color>
    <color name="main_color_dark">#09BF9B</color>

    <!-- Redesign: dark theme surfaces -->
    <color name="bg_primary">#0C0E10</color>
    <color name="bg_surface">#141618</color>
    <color name="bg_raised">#1C1F22</color>
    <color name="bg_stroke">#242729</color>

    <!-- Redesign: text hierarchy -->
    <color name="text_primary_dark">#D8DCE0</color>
    <color name="text_secondary_dark">#6B7580</color>
    <color name="text_dim_dark">#4A5058</color>

    <!-- Redesign: light theme text -->
