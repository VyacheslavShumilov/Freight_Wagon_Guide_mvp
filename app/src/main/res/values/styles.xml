    <!--
    CHANGED — Fragments_Orv_Sample_Text
    Учебный длинный текст. Ключевые параметры:
    • Lato 15sp — на 1sp мельче основного для плотности, но по-прежнему
      комфортно читается (шрифт Lato специально разработан для длинных
      текстов).
    • lineSpacingMultiplier=1.4 — обязательно для абзацев от 3 строк;
      без этого строки слипаются, глаз устаёт.
    • colorOnSurface — чуть приглушённый белый, не перегружает зрение
      на тёмном фоне (чистый белый слишком контрастен для длинных
      текстов).
    • letterSpacing=0.01 — микро-разрежение для удобства чтения на тёмной
      теме (стандартный приём из Notion, Medium dark mode).
    • Вертикальные паддинги 12dp — текст не липнет к картинкам сверху/снизу.
    • Горизонтальные паддинги 4dp — компенсация того, что родительский
      padding 8dp, а картинки идут в match_parent без отступов.
-->
    <style name="Fragments_Orv_Sample_Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!--
        CHANGED — Fragment_Sample_ImageView
        Учебные иллюстрации. Ключевое:
        • centerInside вместо centerCrop — картинка не обрезается.
          Для обучающих схем это критично: обрезанная деталь = потерянная
          информация.
        • adjustViewBounds=true — высота пропорциональна ширине, нет
          артистично-растянутых картинок.
        • Фон colorSurface — даёт едва заметную подложку под картинки
          с прозрачными краями, делает их связкой "это одно изображение"
          на фоне экрана.
        • Верхний margin 4dp — воздух от предыдущего текстового блока.
    -->
    <style name="Fragment_Sample_ImageView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="No_Internet_Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorText</item>
        <item name="android:singleLine">false</item>
    </style>

    <!-- ─── NEW: Filter chip в стилистике приложения ───────────────────────── -->
    <!--
        Визуальные решения:
        • corner radius 10dp — перекликается с cardView_corner_radius,
          не капсула (капсула смотрелась бы инородно на фоне прямых бейджей).
        • IBM Plex Mono bold — тот же шрифт, что у номеров моделей и бейджей.
        • Подчёркивание активного чипа акцентом — перекликается с бейджем "60.00 т".
        • checkedIcon убрана: выделение уже читается цветом и обводкой,
          галочка только ломала бы ширину чипа при переключении.
    -->
    <style name="SMGR.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="rippleColor">@color/chip_filter_ripple</item>

        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>

        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>

        <!-- убираем галочку выделения -->
        <item name="checkedIconVisible">false</item>
        <item name="checkedIcon">@null</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <!--
     FIXED — добавлен явный parent="".
     Без parent Android пытается неявно наследовать от "SMGR.Toolbar"
     (имени до последней точки), которого не существует → ошибка AAPT.
     parent="" отключает неявное наследование и делает стиль самодостаточным.
 -->
    <style name="SMGR.Toolbar.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ─── Favourite card: компактные label/value пары ─────────────────── -->

    <!--
        NEW — SMGR.Favourite.ParamLabel
        Мелкая подпись параметра. Uppercase + letter-spacing = визуальный сигнал
        "вторичная информация, не читается как текст". Моноширинный — чтобы
        две колонки меток выравнивались по ширине.
    -->
    <style name="SMGR.Favourite.ParamLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorStaticText</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
        NEW — SMGR.Favourite.ParamValue
        Значение параметра. Моноширинный bold для табличной выровненности
        чисел. Размер (13sp) балансирует читаемость и компактность в 2-колоночной сетке.
    -->
    <style name="SMGR.Favourite.ParamValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!--
        NEW — SMGR.Favourite.ParamValue.Separator
        Разделитель между значениями тары ("/"). Тусклее основного,
        чтобы не спорил с цифрами за внимание.
    -->
    <style name="SMGR.Favourite.ParamValue.Separator">
        <item name="android:textColor">?attr/colorStaticText</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════
     Стили для стартового экрана (MainActivity) — переработаны.
     Выстраивают чёткую типографическую иерархию:
       Hero title (крупный) > Caption (мелкий, приглушённый) > Tech data (моно)
═══════════════════════════════════════════════════════════════════ -->

    <!--
        NEW — SMGR.Main.HeroTitle
        Главный заголовок приложения. Крупный Lato Bold с letter-spacing —
        такой приём "разрежённого заголовка" используется в премиальных
        приложениях (Telegram FAQ, Spotify splash), создаёт ощущение
        "доверенного продукта".
    -->
    <style name="SMGR.Main.HeroTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
        NEW — SMGR.Main.Caption
        Подзаголовок типа "Включает данные справочников:". Мелкий, приглушённый,
        uppercase с letter-spacing — типичный паттерн "служебная метка" в
        Material-приложениях (Google Keep, Notes-приложения).
    -->
    <style name="SMGR.Main.Caption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorStaticText</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
        NEW — SMGR.Main.TechLine
        Строка технических данных (версия, дата). Моноширинный IBM Plex Mono —
        как в списках моделей и карточках вагона, создаёт визуальную связь
        "это тоже техническая/справочная информация".
    -->
    <style name="SMGR.Main.TechLine" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════
     Унификация ОРВ-экранов. Заменяют старые Fragments_Orv_* и
     Bogies_Components_Item_Header — но оставляем старые стили живыми
     через наследование, чтобы существующие 6 фрагментов продолжали
     работать и автоматически получили новый вид.
═══════════════════════════════════════════════════════════════════ -->

    <!--
        NEW — SMGR.Orv.Tile (card)
        Тайл-кнопка в сетке OrvListFragment. Та же эстетика, что карточки
        параметров вагона: фон colorSurface, тонкая граница, радиус 14dp.
    -->
    <style name="SMGR.Orv.Tile" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!--
    CHANGED — SMGR.Orv.Tile.Content
    Было: paddingTop/Bottom=20dp — давало 40dp пустоты.
    Стало: 12dp — компактнее, карточки перестают вытягиваться.
-->
    <style name="SMGR.Orv.Tile.Content" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>         <!-- было 20dp -->
        <item name="android:paddingBottom">12dp</item>      <!-- было 20dp -->
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!--
        CHANGED — SMGR.Orv.Tile.Title
        Было: paddingTop=12dp между иконкой и текстом.
        Стало: 8dp — текст ближе к иконке, "связанная" пара.
    -->
    <style name="SMGR.Orv.Tile.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:paddingTop">8dp</item>           <!-- было 12dp -->
    </style>

    <!-- ══════════════════════════════════════════════════════════════════
         ПЕРЕОПРЕДЕЛЕНИЕ существующих стилей ОРВ-фрагментов.
         Fragments_Orv_Header/Text/Value используются во ВСЕХ 6 фрагментах
         (BreakSystem, Wheelset, Bogie, Sample, AutomaticCoupler, Components).
         Меняем их — меняется весь раздел разом, без правки 3000+ строк XML.
    ═══════════════════════════════════════════════════════════════════ -->
    <!-- ══════════════════════════════════════════════════════════════════
         Карточки тележек и компонентов (item_bogies / item_bogie_components).
         Отдельные стили вместо Bogies_Components_Item_* — те оставим живыми
         для обратной совместимости, новые сюда.
    ═══════════════════════════════════════════════════════════════════ -->

    <!--
        NEW — SMGR.Bogie.Code
        Код модели тележки — моноширинный bold, как код вагона в списке моделей.
        Создаёт визуальную связь: "18-100" и "11-066-04" читаются одинаково.
    -->
    <style name="SMGR.Bogie.Code" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
        NEW — SMGR.Bogie.Factory
        Производитель — Lato обычный, приглушённый серый colorStaticText.
        Вторичная информация, визуально подчинённая коду.
    -->
    <style name="SMGR.Bogie.Factory" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorStaticText</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <!--
    NEW — SMGR.Sample.Divider
    Тонкий приглушённый разделитель между секциями "картинка+текст".
    Используется в fragment_sample_*.xml вместо дефолтных параметров
    MaterialDivider, которые слишком резкие для учебных экранов.

    Применять через style="..." в MaterialDivider.
    Либо — если не хотите трогать 8 файлов — переопределить атрибуты
    MaterialDivider глобально в теме через materialDividerStyle.
-->
    <style name="SMGR.Sample.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="dividerColor">?attr/colorSurfaceVariant</item>
        <item name="android:alpha">0.4</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>