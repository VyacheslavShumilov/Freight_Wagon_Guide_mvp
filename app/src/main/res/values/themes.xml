<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        REDESIGN — Theme.SMGRApp (светлая тема).

        Что починено:
        1. colorPrimary: было #8009B36F (зелёный с alpha 50% — отсюда
           «бледные» кнопки) → main_color_light_solid (полная непрозрачность).
        2. colorSurfaceVariant: было @color/white = равно фону, обводки
           невидимы → bg_stroke_light (#E1E4E8) — заметный, но спокойный.
        3. colorMainBackground: white → bg_primary_light (#F5F6F7).
           Карточки теперь видны на фоне за счёт тонального контраста.
        4. colorOrvTxtBackground: было bg_surface (#141618 — ТЁМНЫЙ!),
           отсюда чёрные прямоугольники в ОРВ → bg_surface_light (белый).
        5. colorOnSurface: black → text_primary_light (#1A1C1E) — мягче
           для длинного чтения.
    -->
    <style name="Theme.SMGRApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/main_color_light_solid</item>
        <item name="colorPrimaryVariant">@color/main_color_light_solid</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/main_color_light_solid</item>
        <item name="colorSecondaryVariant">@color/main_color_light_solid</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surfaces -->
        <item name="colorSurface">@color/bg_surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">@color/bg_stroke_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <!-- App-specific attrs -->
        <item name="colorTab">@color/text_primary_light</item>
        <item name="colorText">@color/text_primary_light</item>
        <item name="colorStaticText">@color/text_secondary_light</item>
        <!--
            FIXED — colorOrvTxtBackground теперь светлый.
            Был tied к bg_surface (#141618) — это же значение
            используется в тёмной теме. Из-за этого в ОРВ-фрагментах
            на светлой теме появлялись чёрные прямоугольники.
        -->
        <item name="colorOrvTxtBackground">@color/bg_surface_light</item>
        <item name="colorMainBackground">@color/bg_primary_light</item>
        <item name="colorPlayBtn">@color/main_color_light_solid</item>
        <!-- Status bar -->
        <item name="android:statusBarColor"
            tools:targetApi="l">?attr/colorPrimary</item>
        <!-- Typography & dividers -->
        <item name="android:fontFamily">@font/lato</item>
        <item name="materialDividerStyle">@style/SMGR.Sample.Divider</item>
    </style>

    <style name="Theme.SMGRApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SMGRApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.SMGRApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>